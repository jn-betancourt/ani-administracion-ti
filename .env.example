# Configuración del Servidor Web y API - ANI
PORT=3000
NODE_ENV=development

# Configuración de Seguridad y JWT
JWT_SECRET=ani_seguridad_infraestructura_secret_2026_jwt
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Almacenamiento Persistente Documental (Volumen NFS)
# En desarrollo local: ./storage/nfs_docs
# En producción Docker / Multipass: /var/ani/documentos
STORAGE_PATH=./storage/nfs_docs

# URLs Base y CORS
CORS_ORIGIN=*

# Simulación de Servicios Servidor Linux (LAN)
NTP_SERVER=10.88.199.10
NFS_SERVER=10.88.199.10:/srv/nfs/ani_docs
SAMBA_SERVER=//10.88.199.10/ani_docs
NIS_DOMAIN=ani.lan
CUPS_SERVER=ipp://10.88.199.10:631/printers/ani_sede_principal
