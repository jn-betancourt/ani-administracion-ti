{
  "name": "ani-backend-api",
  "version": "1.0.0",
  "description": "Backend API y Servidor Web de la Agencia Nacional de Infraestructura (ANI) - Consolidación de Servicios TI",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "build:admin": "cd admin_spa && npm run build",
    "build:all": "npm run build && cd admin_spa && npm run build",
    "admin:dev": "cd admin_spa && npm run dev",
    "start": "node dist/server.js",
    "test:health": "curl -s http://localhost:3000/health | jq"
  },
  "keywords": [
    "ani",
    "dokploy",
    "traefik",
    "express",
    "api",
    "admin_ti"
  ],
  "author": "Juan Betancourt",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
